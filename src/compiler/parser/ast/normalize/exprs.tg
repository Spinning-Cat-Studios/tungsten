// src/compiler/parser/ast/normalize/exprs.tg
// The driver never reaches this module: span normalization is a test affordance,
// imported only by the AST-comparison entry files. See normalize/mod.tg
// (ADR 3.9.26a).
// Span normalization for expressions.
//
// `strip_spans_expr` is the entry point the ADR's acceptance criterion names, and
// the one tests reach for; the sibling `strip_spans_*` functions normalize the
// node types reachable from an expression. `BinOp` and `UnaryOp` carry no span
// and are passed through untouched.

use parser::ast::nodes::exprs::{
    Expr, ExprPath, ExprIntLit, ExprBoolLit, ExprStringLit, ExprUnit,
    ExprLambda, ExprApp, ExprTypeApp, ExprBinary, ExprUnary, ExprLet,
    ExprBlock, ExprIf, ExprMatch, ExprTuple, ExprRecordLit, ExprNamedRecord,
    ExprField, ExprAnnot, ExprParen, ExprHave, ExprShow, ExprAssume, ExprRefl,
    ExprSubst, ExprSym, ExprTrans, ExprCong, ExprNatInd, ExprNatRec,
    ExprSorry, ExprReturn, ExprTry, ExprTryBlock, ExprLetElse, ExprIfLet,
    ExprIfLetChain, ExprError,
    MaybeExpr, NoExpr, SomeExpr
};
use parser::ast::normalize::common::{canonical_span, strip_spans_ident, strip_spans_path};
use parser::ast::normalize::patterns::{strip_spans_pattern};
use parser::ast::normalize::types::{strip_spans_type_expr, strip_spans_type_expr_list, strip_spans_maybe_type_expr};
use parser::ast::normalize::nodes::{
    strip_spans_lambda_param_list, strip_spans_motive, strip_spans_field_init_list,
    strip_spans_match_arm_list, strip_spans_stmt_list, strip_spans_if_let_condition_list
};
use driver::ffi::{List, Nil, Cons};

/// Normalize every span reachable from an expression.
///
/// This is the normalizer ADR 29.6.26f's equality policy refers to: comparison
/// is exact, so a test that wants position-insensitive equality applies this to
/// both sides first.
pub fn strip_spans_expr(e: Expr) -> Expr {
    match e {
        ExprPath(p) => ExprPath(strip_spans_path(p)),
        ExprIntLit(n, _) => ExprIntLit(n, canonical_span()),
        ExprBoolLit(b, _) => ExprBoolLit(b, canonical_span()),
        ExprStringLit(s, _) => ExprStringLit(s, canonical_span()),
        ExprUnit(_) => ExprUnit(canonical_span()),
        ExprLambda(ps, body, _) =>
            ExprLambda(strip_spans_lambda_param_list(ps), strip_spans_expr(body), canonical_span()),
        ExprApp(f, args, _) => ExprApp(strip_spans_expr(f), strip_spans_expr_list(args), canonical_span()),
        ExprTypeApp(f, tys, _) =>
            ExprTypeApp(strip_spans_expr(f), strip_spans_type_expr_list(tys), canonical_span()),
        ExprBinary(op, a, b, _) => ExprBinary(op, strip_spans_expr(a), strip_spans_expr(b), canonical_span()),
        ExprUnary(op, a, _) => ExprUnary(op, strip_spans_expr(a), canonical_span()),
        ExprLet(pat, ty, v, body, _) =>
            ExprLet(strip_spans_pattern(pat), strip_spans_maybe_type_expr(ty),
                    strip_spans_expr(v), strip_spans_expr(body), canonical_span()),
        ExprBlock(stmts, tail, _) =>
            ExprBlock(strip_spans_stmt_list(stmts), strip_spans_maybe_expr(tail), canonical_span()),
        ExprIf(c, t, f, _) =>
            ExprIf(strip_spans_expr(c), strip_spans_expr(t), strip_spans_expr(f), canonical_span()),
        ExprMatch(scrut, arms, _) =>
            ExprMatch(strip_spans_expr(scrut), strip_spans_match_arm_list(arms), canonical_span()),
        ExprTuple(elems, _) => ExprTuple(strip_spans_expr_list(elems), canonical_span()),
        ExprRecordLit(spread, fields, _) =>
            ExprRecordLit(strip_spans_maybe_expr(spread), strip_spans_field_init_list(fields), canonical_span()),
        ExprNamedRecord(path, spread, fields, _) =>
            ExprNamedRecord(strip_spans_path(path), strip_spans_maybe_expr(spread),
                            strip_spans_field_init_list(fields), canonical_span()),
        ExprField(base, name, _) =>
            ExprField(strip_spans_expr(base), strip_spans_ident(name), canonical_span()),
        ExprAnnot(v, ty, _) => ExprAnnot(strip_spans_expr(v), strip_spans_type_expr(ty), canonical_span()),
        ExprParen(inner, _) => ExprParen(strip_spans_expr(inner), canonical_span()),
        ExprHave(name, ty, proof, body, _) =>
            ExprHave(strip_spans_ident(name), strip_spans_type_expr(ty),
                     strip_spans_expr(proof), strip_spans_expr(body), canonical_span()),
        ExprShow(ty, proof, _) =>
            ExprShow(strip_spans_type_expr(ty), strip_spans_expr(proof), canonical_span()),
        ExprAssume(name, ty, body, _) =>
            ExprAssume(strip_spans_ident(name), strip_spans_type_expr(ty), strip_spans_expr(body), canonical_span()),
        ExprRefl(_) => ExprRefl(canonical_span()),
        ExprSubst(proof, motive, witness, _) =>
            ExprSubst(strip_spans_expr(proof), strip_spans_motive(motive), strip_spans_expr(witness), canonical_span()),
        ExprSym(proof, _) => ExprSym(strip_spans_expr(proof), canonical_span()),
        ExprTrans(a, b, _) => ExprTrans(strip_spans_expr(a), strip_spans_expr(b), canonical_span()),
        ExprCong(f, proof, _) => ExprCong(strip_spans_expr(f), strip_spans_expr(proof), canonical_span()),
        ExprNatInd(motive, base, step, n, _) =>
            ExprNatInd(strip_spans_motive(motive), strip_spans_expr(base),
                       strip_spans_expr(step), strip_spans_expr(n), canonical_span()),
        ExprNatRec(ty, base, step, n, _) =>
            ExprNatRec(strip_spans_type_expr(ty), strip_spans_expr(base),
                       strip_spans_expr(step), strip_spans_expr(n), canonical_span()),
        ExprSorry(_) => ExprSorry(canonical_span()),
        ExprReturn(v, _) => ExprReturn(strip_spans_maybe_expr(v), canonical_span()),
        ExprTry(inner, _) => ExprTry(strip_spans_expr(inner), canonical_span()),
        ExprTryBlock(inner, _) => ExprTryBlock(strip_spans_expr(inner), canonical_span()),
        ExprLetElse(pat, ty, v, diverge, body, _) =>
            ExprLetElse(strip_spans_pattern(pat), strip_spans_maybe_type_expr(ty),
                        strip_spans_expr(v), strip_spans_expr(diverge), strip_spans_expr(body), canonical_span()),
        ExprIfLet(pat, scrut, body, fallback, _) =>
            ExprIfLet(strip_spans_pattern(pat), strip_spans_expr(scrut),
                      strip_spans_expr(body), strip_spans_maybe_expr(fallback), canonical_span()),
        ExprIfLetChain(conds, body, fallback, _) =>
            ExprIfLetChain(strip_spans_if_let_condition_list(conds), strip_spans_expr(body),
                           strip_spans_maybe_expr(fallback), canonical_span()),
        ExprError(_) => ExprError(canonical_span())
    }
}

pub fn strip_spans_expr_list(es: List<Expr>) -> List<Expr> {
    match es {
        Nil() => Nil(),
        Cons(e, rest) => Cons(strip_spans_expr(e), strip_spans_expr_list(rest))
    }
}

pub fn strip_spans_maybe_expr(e: MaybeExpr) -> MaybeExpr {
    match e {
        NoExpr() => NoExpr(),
        SomeExpr(inner) => SomeExpr(strip_spans_expr(inner))
    }
}
