// src/compiler/parser/ast/normalize/patterns.tg
// The driver never reaches this module: span normalization is a test affordance,
// imported only by the AST-comparison entry files. See normalize/mod.tg
// (ADR 3.9.26a).
// Span normalization for patterns.
//
// `PatLit` carries no span, so pattern literals are passed through untouched.

use parser::ast::pattern::{
    Pattern, PatWildcard, PatVar, PatLiteral, PatTuple, PatConstructor, PatOr, PatError
};
use parser::ast::normalize::common::{canonical_span, strip_spans_ident, strip_spans_path};
use driver::ffi::{List, Nil, Cons};

/// Normalize every span in a pattern.
pub fn strip_spans_pattern(p: Pattern) -> Pattern {
    match p {
        PatWildcard(_) => PatWildcard(canonical_span()),
        PatVar(id) => PatVar(strip_spans_ident(id)),
        PatLiteral(lit, _) => PatLiteral(lit, canonical_span()),
        PatTuple(elems, _) => PatTuple(strip_spans_pattern_list(elems), canonical_span()),
        PatConstructor(path, args, _) =>
            PatConstructor(strip_spans_path(path), strip_spans_pattern_list(args), canonical_span()),
        PatOr(a, b, _) => PatOr(strip_spans_pattern(a), strip_spans_pattern(b), canonical_span()),
        PatError(_) => PatError(canonical_span())
    }
}

pub fn strip_spans_pattern_list(ps: List<Pattern>) -> List<Pattern> {
    match ps {
        Nil() => Nil(),
        Cons(p, rest) => Cons(strip_spans_pattern(p), strip_spans_pattern_list(rest))
    }
}
