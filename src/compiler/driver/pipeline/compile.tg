// src/compiler/driver/pipeline/compile.tg
// Compile pipeline: check + codegen.
//
// Delegates codegen to the bootstrap compiler binary via subprocess.
// The self-hosted check runs first for diagnostics; if it passes,
// the bootstrap binary produces the actual binary.
//
// ## The consequence, which is easy to miss (ADR 3.9.26a)
//
// The self-host's OWN elaboration never reaches the emitted binary. `tungsten2`
// is elaborated twice — once by `tungsten1` here, discarded, and once by the
// bootstrap below, and it is the BOOTSTRAP's elaboration that becomes machine
// code. Two things follow, and both have already cost an ADR:
//
// - A defect in the self-hosted elaborator can produce a wrong Core term AND a
//   correct `tungsten2`, so no test that runs `tungsten2` can see it. ADR
//   20.8.26c's thesis predicted a lexing failure in `tungsten2` that cannot
//   happen, for exactly this reason.
// - `src/compiler/codegen/` is on no driver path at all. It is imported only by
//   `test_codegen*.tg` / `test_cir_captures.tg`; see its mod.tg.
//
// Census: `tungsten doctor audit-driver-reach src/compiler/main.tg`.

use driver::ffi::{
    eprintln, stderr_is_tty,
    List, Nil, Cons,
    exec_process_outcome, exec_succeeded, string_len
};
use driver::util::{
    Option, Some, None,
    string_eq, nat_to_string, list_reverse
};
use driver::pipeline::bootstrap_lookup::{
    find_bootstrap_choice, bootstrap_source_label, bootstrap_failure_message
};
use driver::cli::{CheckOpts, CompileOpts};
use driver::modules::build::{strip_tg_extension};
use elab::env::types::{ElabCompile};
use elab::error::render::colors::{colorize_bold, ColorRed, ColorCyan};
use elab::error::{default_max_errors};
use driver::pipeline::{PipelineResult, PipelineOk, PipelineErr};
use driver::pipeline::check::run_check;

// ===========================================================================
// COMPILE PIPELINE
// ===========================================================================

/// Run the compile pipeline: check + codegen.
pub fn run_compile(opts: CompileOpts) -> PipelineResult {
    let use_color = stderr_is_tty();
    
    // First, run the check pipeline
    let max_errors = default_max_errors();
    let check_opts: CheckOpts = { file: opts.file, verbose: opts.verbose, max_errors: max_errors, dump_core: None, dump_core_terms: None, check_tyvar_escape: false, check_free_vars: false, check_well_typed: false, elab_mode: ElabCompile };
    let check_result = run_check(check_opts);
    
    match check_result {
        PipelineErr(n) => PipelineErr(n),
        PipelineOk(def_count) => {
            // Check succeeded — delegate codegen to bootstrap binary
            let bootstrap = find_bootstrap_choice();

            // Use sentinel: empty string means "not specified", derive from file
            let output = if string_eq(opts.output, "") {
                strip_tg_extension(opts.file)
            } else {
                opts.output
            };
            
            // Build argument list
            let args = Cons("compile", Cons(opts.file, Cons("-o", Cons(output, Nil))));
            let args = if opts.verbose { append(args, Cons("-v", Nil)) } else { args };
            let args = if opts.emit_llvm { append(args, Cons("--emit-llvm", Nil)) } else { args };
            
            if opts.verbose {
                eprintln(colorize_bold("info", ColorCyan, use_color) ++
                        ": delegating codegen to bootstrap (" ++ bootstrap.path ++
                        ", chosen by " ++ bootstrap_source_label(bootstrap.source) ++ ")")
            };

            // `let` first: an effectful call written into an `if` condition runs
            // TWICE on the self-compiled binary (see driver/pipeline/test/execute.tg).
            let outcome = exec_process_outcome(bootstrap.path, args);

            if exec_succeeded(outcome) {
                if opts.verbose {
                    eprintln(colorize_bold("info", ColorCyan, use_color) ++
                            ": compilation succeeded (" ++ nat_to_string(def_count) ++ " definitions)")
                };
                PipelineOk(def_count)
            } else {
                // Unconditionally — not only under `-v`. The path is the whole
                // diagnosis when the resolution was wrong (ADR 3.9.26b §2.2).
                eprintln(colorize_bold("error", ColorRed, use_color) ++
                        bootstrap_failure_message(bootstrap, outcome));
                PipelineErr(1)
            }
        }
    }
}

/// Append two lists.
fn append<T>(xs: List<T>, ys: List<T>) -> List<T> {
    append_acc(list_reverse(xs), ys)
}

fn append_acc<T>(reversed_xs: List<T>, ys: List<T>) -> List<T> {
    match reversed_xs {
        Nil() => ys,
        Cons(x, rest) => append_acc(rest, Cons(x, ys))
    }
}
