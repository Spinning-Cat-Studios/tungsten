// src/compiler/driver/pipeline/test/harness/tree.tg
// Tree mode: qualified paths, no `use`, no externs (ADR 7.8.26b §2.1).
//
// Tree mode emits ZERO `use` statements and ZERO externs, referencing
// everything by canonical defining path. Emitting `use` would re-import names
// the user file already imported — the §1.2 collision again, one level up —
// and canonical paths (`driver::util::strings::convert::nat_to_string`, not
// `driver::util::nat_to_string`) also sidestep re-export visibility capping.
//
// The only root names tree mode adds are `main` and `_harness_*`. That is the
// invariant, discharged.
//
// Two of §1.3's defects die here without being targeted. `process_exit` returns
// `Never` — a real one-constructor ADT rather than bottom, so it does not
// coerce to `Nat` — hence `runner.tg`'s exit-then-value shape rather than the
// old `-> Unit`-declared `tg_exit` under a `-> Nat` signature. And the real
// `nat_to_string` replaces `_harness_nat_to_string`, killing the `"many"` cap.

use driver::pipeline::test::harness::runner::{HarnessCalls};

/// The five symbols below are exactly `tree_mode_symbols()` in
/// `mode/types.tg`, which is what detection checks for before choosing this
/// mode. If one moves, both move.
pub fn tree_calls() -> HarnessCalls {
    {
        test_begin: "driver::ffi::test::test_begin",
        test_check_failure: "driver::ffi::test::test_check_failure",
        nat_to_string: "driver::util::strings::convert::nat_to_string",
        exit_fn: "driver::ffi::process::process_exit"
    } : HarnessCalls
}

/// Everything tree mode declares before `main`: one line.
///
/// `_harness_println` exists so the runner chain is shared verbatim with
/// standalone mode, which has no `println` to qualify. It is a `_harness_*`
/// name, so it is inside what D2 permits.
pub fn tree_prelude() -> String {
    "// --- Test harness (generated by tungsten test, tree mode) ---\n" ++
    "fn _harness_println(s: String) -> Unit {\n" ++
    "    driver::ffi::process::println(s)\n" ++
    "}\n"
}
