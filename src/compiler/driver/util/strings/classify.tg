// String and character classification: emptiness, digits, all-numeric.

use driver::ffi::{string_len, string_char_at_internal};

/// Check if string is empty.
pub fn string_is_empty(s: String) -> Bool {
    string_len(s) == 0
}

/// Check if character is a digit (0-9).
pub fn is_digit(c: Nat) -> Bool {
    c >= 48 && c <= 57  // '0' = 48, '9' = 57
}

/// Check if string contains only digits.
pub fn is_numeric(s: String) -> Bool {
    let len = string_len(s);
    if len == 0 {
        false
    } else {
        is_numeric_loop(s, 0, len)
    }
}

// Partial (ADR 11.8.26b): no parameter is a structural subterm to descend on,
// so this is a measure recursion — Non-Goals defers those to v2.1. Executable
// compiler code that no proof reaches; E0063 fires if that ever changes.
#[partial]
fn is_numeric_loop(s: String, i: Nat, len: Nat) -> Bool {
    if i >= len {
        true
    } else {
        let c = string_char_at_internal(s, i);
        if is_digit(c) {
            is_numeric_loop(s, i + 1, len)
        } else {
            false
        }
    }
}
