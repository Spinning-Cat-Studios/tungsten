// Conversion between strings and natural numbers.

use driver::ffi::{string_len, string_char_at_internal};
use parser::option::{Option, Some, None};
use driver::util::strings::classify::is_digit;

/// Parse a string as a natural number.
/// Returns None if the string is not a valid number.
pub fn parse_nat(s: String) -> Option<Nat> {
    let len = string_len(s);
    if len == 0 {
        None
    } else {
        parse_nat_loop(s, 0, len, 0)
    }
}

// Partial (ADR 11.8.26b): no parameter is a structural subterm to descend on,
// so this is a measure recursion — Non-Goals defers those to v2.1. Executable
// compiler code that no proof reaches; E0063 fires if that ever changes.
#[partial]
fn parse_nat_loop(s: String, i: Nat, len: Nat, acc: Nat) -> Option<Nat> {
    if i >= len {
        Some(acc)
    } else {
        let c = string_char_at_internal(s, i);
        if is_digit(c) {
            let digit = c - 48;  // '0' = 48
            parse_nat_loop(s, i + 1, len, acc * 10 + digit)
        } else {
            None
        }
    }
}

/// Convert a natural number to string.
pub fn nat_to_string(n: Nat) -> String {
    if n == 0 {
        "0"
    } else {
        nat_to_string_acc(n, "")
    }
}

/// Helper for nat_to_string - accumulates digits.
// Partial (ADR 11.8.26b): no parameter is a structural subterm to descend on,
// so this is a measure recursion — Non-Goals defers those to v2.1. Executable
// compiler code that no proof reaches; E0063 fires if that ever changes.
#[partial]
pub fn nat_to_string_acc(n: Nat, acc: String) -> String {
    if n == 0 {
        acc
    } else {
        let digit = n % 10;
        let rest = n / 10;
        let char = digit_to_char(digit);
        nat_to_string_acc(rest, char ++ acc)
    }
}

/// Convert digit (0-9) to single-character string.
pub fn digit_to_char(d: Nat) -> String {
    if d == 0 { "0" }
    else if d == 1 { "1" }
    else if d == 2 { "2" }
    else if d == 3 { "3" }
    else if d == 4 { "4" }
    else if d == 5 { "5" }
    else if d == 6 { "6" }
    else if d == 7 { "7" }
    else if d == 8 { "8" }
    else { "9" }
}
