// Ten failing tests, so the runner has to render a two-digit count.
//
// ADR 7.8.26b §1.3: the generated harness carried its own
// `_harness_nat_to_string` as a ten-arm table returning `"many"` for n >= 10 —
// it existed only because the harness emitted no imports and so could not
// reach the real `nat_to_string`. Ten is the smallest count that tells the two
// apart, and nothing else standalone has ten tests.
//
// Expected: every test FAILED, the summary reads `10 failed` (not `many
// failed`), and the process exits 1.

extern "C" fn tg_assert_eq_nat(left: Nat, right: Nat) -> Unit
fn assert_eq_nat(a: Nat, b: Nat) -> Unit { tg_assert_eq_nat(a, b) }

pub fn test_fail_00() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_01() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_02() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_03() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_04() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_05() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_06() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_07() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_08() -> Unit { assert_eq_nat(0, 1) }
pub fn test_fail_09() -> Unit { assert_eq_nat(0, 1) }
