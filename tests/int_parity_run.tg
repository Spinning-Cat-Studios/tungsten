// tests/int_parity_run.tg — ADR 14.9.26c AC 3 parity battery
//
// One program that reaches every `Int` node the evaluator and the native
// backend each implement separately — literals (folded and negated),
// checked `+ - *`, guarded `/ %` at the sign boundaries, the six signed
// comparisons, and both bridges at their documented edges — and prints each
// result. `tungsten diff exec` runs it on the evaluator AND natively and
// compares stdout, which is the only cheap check that sees a three-way
// disagreement between the kernel rule, the evaluator table and the LLVM
// lowering: a truncating division that both sides got wrong the same way
// would pass every single-path test.
//
// Standalone on purpose, like `arena_mode_run.tg`: it declares its own
// externs so the fixture costs a handful of symbols, not the compiler. The
// values stay clear of the `Nat` boundaries — `Nat`'s own evaluator/native
// divergence is a recorded Non-Goal, not this fixture's business.

extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

fn digit(d: Nat) -> String {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
    else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
    else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
    else { "9" }
}

/// Render a Nat in decimal.
#[partial]
fn nat_to_string(n: Nat) -> String {
    if n < 10 {
        digit(n)
    } else {
        nat_to_string(n / 10) ++ digit(n % 10)
    }
}

/// Render an Int in decimal, sign first. The magnitude goes through
/// `from_int` of the negation, so `MIN` is deliberately not rendered here
/// (its negation traps — that is the overflow fixture's job).
fn int_to_string(i: Int) -> String {
    if i < 0 {
        "-" ++ nat_to_string(from_int(-i))
    } else {
        nat_to_string(from_int(i))
    }
}

// `show` is a proof keyword (`tungsten explain keywords show`), hence `emit`.
fn emit(label: String, i: Int) -> Unit {
    println(label ++ " = " ++ int_to_string(i))
}

fn emit_bool(label: String, b: Bool) -> Unit {
    println(label ++ " = " ++ (if b { "true" } else { "false" }))
}

fn main() -> Unit {
    // Literals: positive, negated, expected-type-driven, one below the top.
    emit("lit", 42);
    emit("neg_lit", -42);
    emit("max_minus_one", 9223372036854775806);
    emit("min_plus_one", -9223372036854775807);

    // Checked arithmetic, mixed signs.
    emit("add", -3 + 5);
    emit("sub", 3 - 5);
    emit("mul", -7 * 2);
    emit("mul_neg_neg", -7 * -2);

    // Division and modulo truncate toward zero, remainder takes the
    // dividend's sign — `sdiv`/`srem` on one side, `checked_div`/`checked_rem`
    // on the other, and this is the line that proves they agree.
    emit("div", -7 / 2);
    emit("mod", -7 % 2);
    emit("div_pos_neg", 7 / -2);
    emit("mod_pos_neg", 7 % -2);
    emit("div_neg_neg", -7 / -2);
    emit("mod_neg_neg", -7 % -2);
    emit("div_exact", -8 / 2);
    emit("mod_zero_result", -8 % 2);

    // Negation of a variable, not a literal (the folded form is above).
    let x: Int = 17;
    emit("neg_var", -x);
    emit("neg_neg_var", -(-x));

    // Signed comparisons at both orderings and equality.
    emit_bool("lt", -1 < 0);
    emit_bool("lt_false", 0 < -1);
    emit_bool("le_eq", -1 <= -1);
    emit_bool("gt", 0 > -1);
    emit_bool("ge_false", -1 >= 0);
    emit_bool("eq", -5 == -5);
    emit_bool("ne", -5 != 5);

    // Bridges at the edges: negatives clamp, the maximum round-trips.
    let n: Nat = 12;
    emit("to_int", to_int(n));
    println("from_int_neg = " ++ nat_to_string(from_int(-1)));
    println("from_int_pos = " ++ nat_to_string(from_int(-(-99))));
    println("round_trip = " ++ nat_to_string(from_int(to_int(n))));
    emit_bool("max_round_trips", to_int(from_int(9223372036854775807)) == 9223372036854775807);

    // A `Nat` expression beside `Int` ones stays `Nat`: saturating, unsigned.
    println("nat_sat = " ++ nat_to_string(3 - 5));
    println("done")
}
