// SUBJECT — arity 3, PRODUCT tail, expression position (ADR 4.9.26c).
//
// The pattern-side analogue of the field-side defect, and the one shape both
// axes reach: the last element of the tuple is itself a tuple, so the encoded
// spine is four long where the pattern has three binders. A builder that stops
// on "the base is no longer a product" binds `c` to `3` instead of `(3, 4)`,
// and the inner destructure then reads a scalar as a pair.

pub fn main() -> Nat {
    let p = (1, 2, (3, 4));
    let r = let (a, b, c) = p; let (d, e) = c; a * 1000 + b * 100 + d * 10 + e;
    r
}
