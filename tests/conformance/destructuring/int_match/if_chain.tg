// CONTROL — the same selections as `guarded_match.tg`, through `if` chains
// over `==` and `>`, which both compilers already agree on (ADR 18.9.26e).
// A divergence on the subject with this control agreeing is the integer
// match's lowering, not the arithmetic or the comparisons it is built from.

fn classify(n: Int) -> Nat {
    if n == -1 {
        1
    } else if n == 0 || n == 7 {
        2
    } else if n > 100 {
        3
    } else if n == 5 {
        4
    } else {
        5
    }
}

fn small(n: Nat) -> Nat {
    let chosen = if n == 0 { 6 } else if n == 1 || n == 2 { 7 } else { n + 5 };
    chosen
}

pub fn main() -> Nat {
    classify(-1) * 1000000 + classify(7) * 100000 + classify(500) * 10000
        + classify(5) * 1000 + classify(-9) * 100 + small(2) * 10 + small(3)
}
