// CONTROL for `arity3_product_tail.tg` — arity 3, scalar tail. ADR 4.9.26b
// §1.3's `control_tail`, which agreed across both compilers before the fix and
// is what made the subject's divergence attributable to the tail's shape.
//
// Note that this record and its subject share an ENCODING: `Nat × (Nat × (Nat
// × Nat))` reads as three fields with a pair at the end or as four scalars,
// and that ambiguity is the whole reason the field count has to be the
// authority.

type TripleScalar = { head: Nat, mid: Nat, tail: Nat }

pub fn main() -> Nat {
    let r: TripleScalar = { head: 1, mid: 2, tail: 34 };
    r.head * 1000 + r.mid * 100 + r.tail
}
