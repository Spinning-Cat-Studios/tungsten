// Runtime smoke test for first-differing-path materialisation (ADR 29.6.26f
// §2.3 / P5). Run via `tungsten run` (evaluator). `main` sums the path *length*
// at the first difference of each comparison, weighted so each is recoverable.
// The structural first cut emits `Pos(i)` for positional descent and `Tag` for
// tag/length mismatch; field names / flat indices / displays are later refinements.
//
// Expected: 100
//   ×1 : __compare(3, 4)                        leaf      → path []        len 0
//   ×4 : __compare((1,2), (1,3))                 .snd      → [Pos 1]        len 1
//   ×16: __compare(((1,2),(3,4)), ((1,2),(3,5))) .1.1      → [Pos 1, Pos 1] len 2
//   ×64: __compare(none, Some(3))                tag       → [Tag]          len 1

type List<T> =
    | Nil
    | Cons(T, List<T>)

type PathSeg =
    | Field(String)
    | Pos(Nat)
    | Index(Nat)
    | Tag
    | Len
type ComparePath = List<PathSeg>
type CompareDiff = { path: ComparePath, left_display: String, right_display: String }
type CompareResult =
    | Equal
    | NotEqual(CompareDiff)

type Option<T> =
    | None
    | Some(T)

fn path_len(p: ComparePath) -> Nat {
    match p {
        Nil() => 0,
        Cons(_, rest) => 1 + path_len(rest)
    }
}

fn diff_path_len(r: CompareResult) -> Nat {
    match r {
        Equal() => 9,
        NotEqual(d) => path_len(d.path)
    }
}

fn main() -> Nat {
    let none: Option<Nat> = None;
    diff_path_len(__compare(3, 4))
        + diff_path_len(__compare((1, 2), (1, 3))) * 4
        + diff_path_len(__compare(((1, 2), (3, 4)), ((1, 2), (3, 5)))) * 16
        + diff_path_len(__compare(none, Some(3))) * 64
}
