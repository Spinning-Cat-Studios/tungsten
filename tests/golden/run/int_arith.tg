// Golden test (ADR 14.9.26c): signed arithmetic on the evaluator.
// (-7 / 2) truncates toward zero, (-7 % 2) keeps the dividend's sign, and
// the whole expression prints SIGNED: (-3 + 5) * (3 - 5) + (-7 / 2) - (-7 % 2)
// = 2 * -2 + -3 - -1 = -6.
fn main() -> Int {
    (-3 + 5) * (3 - 5) + (-7 / 2) - (-7 % 2)
}
