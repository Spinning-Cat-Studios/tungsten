// Golden test (ADR 14.9.26c AC 3): the native trap line.
// The compiled binary aborts through `tg_int_trap`; the golden runner
// snapshots its stderr, so this pins `error: integer overflow in +` — the
// same bytes run/int_trap.tg pins for the evaluator.
fn signed_max() -> Int { 9223372036854775807 }
fn main() -> Int { signed_max() + 1 }
