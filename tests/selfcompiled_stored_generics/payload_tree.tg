// tests/selfcompiled_stored_generics/payload_tree.tg
// ADR 21.7.26k (D3): tungsten1-run regression battery, L1-matrix mirror.
// This file: Tree (fresh k=2 generic — the StrMap shape) stored in
// CONSTRUCTOR PAYLOAD position (2-ctor sum), across all four argument
// categories. All Tree cells failed pre-fix on L1.

pub type List<T> = Nil | Cons(T, List<T>)

pub type Tree<V> =
    | TreeLeaf
    | TreeNode(Tree<V>, String, V, Tree<V>, Nat)

pub fn touch_tree<X>(t: Tree<X>) -> Tree<X> { t }

type Rec = { count: Nat, label: String }

type Choice =
    | ChoiceNat(Nat)
    | ChoiceStr(String)

// Cell: payload × Tree × builtin (Nat)
type HolderTreeNat =
    | EmptyTreeNat
    | HoldTreeNat(Tree<Nat>)

fn project_htn(h: HolderTreeNat) -> Tree<Nat> {
    match h {
        EmptyTreeNat() => TreeLeaf,
        HoldTreeNat(t) => touch_tree(t)
    }
}

// Cell: payload × Tree × record
type HolderTreeRec =
    | EmptyTreeRec
    | HoldTreeRec(Tree<Rec>)

fn project_htr(h: HolderTreeRec) -> Tree<Rec> {
    match h {
        EmptyTreeRec() => TreeLeaf,
        HoldTreeRec(t) => touch_tree(t)
    }
}

// Cell: payload × Tree × 2-ctor sum
type HolderTreeChoice =
    | EmptyTreeChoice
    | HoldTreeChoice(Tree<Choice>)

fn project_htc(h: HolderTreeChoice) -> Tree<Choice> {
    match h {
        EmptyTreeChoice() => TreeLeaf,
        HoldTreeChoice(t) => touch_tree(t)
    }
}

// Cell: payload × Tree × nested (List<Rec> argument)
type HolderTreeNested =
    | EmptyTreeNested
    | HoldTreeNested(Tree<List<Rec>>)

fn project_htx(h: HolderTreeNested) -> Tree<List<Rec>> {
    match h {
        EmptyTreeNested() => TreeLeaf,
        HoldTreeNested(t) => touch_tree(t)
    }
}

pub fn main() -> Nat {
    let _n = project_htn(HoldTreeNat(TreeLeaf));
    let _r = project_htr(EmptyTreeRec);
    let _c = project_htc(HoldTreeChoice(TreeLeaf));
    let _x = project_htx(EmptyTreeNested);
    0
}
