// tests/console_println_run.tg — ADR 28.7.26a §2.2 console-output fixture
//
// `tungsten diff exec` compares evaluator and native *stdout*, so it only
// tests the console FFI if something on the run path actually prints. Nothing
// in `examples/` does — `hello.tg` returns a String rather than printing one —
// so before this fixture the §2.2 sink could have broken every console write
// and `diff exec examples/hello.tg` would still have reported parity.
//
// The three externs below are the whole console surface the sink intercepts,
// and `println`/`print`/`eprintln` are the exact wrappers
// `src/compiler/driver/ffi/process/mod.tg` defines over them. Both sides must
// agree byte-for-byte:
//   - natively, via the linked `libtungsten_core.a` symbols;
//   - on the evaluator, via the extern arms in
//     `tungsten_core/src/eval/env/handlers/extern_console.rs` — without which
//     an `ExternCall` goes silently Stuck and nothing prints at all.
//
// stderr is written too: `diff exec` compares stdout, so an eprintln that
// leaked into stdout would show up here as a divergence.

extern "C" fn tg_print(s: Nat, len: Nat) -> Unit
extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_eprintln(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

pub fn print(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_print(c, len);
    tg_free_string(c)
}

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

pub fn eprintln(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_eprintln(c, len);
    tg_free_string(c)
}

// Emits exactly:
//   stdout: "line one\npartial done\n\n"
//   stderr: "to stderr\n"
// The bare `println("")` pins the newline-only case, which a sink that
// special-cased empty input would drop.
fn emit() -> Unit {
    println("line one");
    print("partial ");
    println("done");
    eprintln("to stderr");
    println("")
}

fn main() -> Nat {
    emit();
    0
}
